# Supabase project — Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses Row Level Security — used by prisma/seed.ts to
# create the founder's account. NEVER expose this to the browser, and
# keep it out of git (it already is — see .gitignore).
SUPABASE_SERVICE_ROLE_KEY=""

# Database — Settings > Database > Connection string in the Supabase
# dashboard. DATABASE_URL is the pooled "Transaction" connection (port
# 6543, add ?pgbouncer=true) that the app uses at runtime; DIRECT_URL is
# the direct connection (port 5432) that `prisma db push` needs.
DATABASE_URL=""
DIRECT_URL=""

# Seed admin account (created by `npm run db:seed`) — this is the
# founder's login, with access to both branches' admin tools
ADMIN_NAME="Bongiwe Langa"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-seeding"

# Yoco (yoco.com) — powers checkout on the Herbal & Holistic shop. Both
# come from the Yoco dashboard once you've created a business account.
# See README "Selling products online" for the exact setup steps.
YOCO_SECRET_KEY=""
# From Yoco Dashboard > Developer > Webhooks, after registering
# https://<your-domain>/api/webhooks/yoco as a webhook endpoint.
YOCO_WEBHOOK_SECRET=""

# --- Not wired up yet — see README "Where this can go next" ---
# WhatsApp Business Platform (Cloud API), for the chat screen
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Video calling provider (Twilio Video / Agora / Daily.co), for the call screen
# VIDEO_PROVIDER_API_KEY=""
# VIDEO_PROVIDER_API_SECRET=""
