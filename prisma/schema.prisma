// Makosi Traditional Healing — database schema
// Postgres, hosted on Supabase — Supabase Auth owns sign-up/sign-in
// (email+password and Google) in its own `auth.users` table, which this
// schema doesn't model. `Profile` is the app-side row for a user: same id
// as auth.users.id, holding just what our own pages need (name, role).
// A trigger creates it automatically on signup — see supabase/sql/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled ("Transaction mode", port 6543) connection — used at runtime.
  url       = env("DATABASE_URL")
  // Direct (port 5432) connection — required for `prisma db push` /
  // migrations, which need a session-mode connection pgbouncer doesn't give.
  directUrl = env("DIRECT_URL")
}

// One account works across both branches (Journey Home Healing and
// Makosi Herbal & Holistic Products) — there is no per-branch account.
// Supabase Auth is the single identity store either way (password or
// Google), so this is just the role/profile row for it.
//
// `role` (below), `category` and `status` (further down) are plain,
// validated strings rather than Prisma `enum`s, to match how the rest of
// this schema already enforces allowed values in the API routes instead
// (see e.g. src/app/api/products/route.ts) rather than at the DB level.
model Profile {
  id        String   @id @db.Uuid // same id as the matching auth.users row
  name      String
  role      String   @default("CUSTOMER") // CUSTOMER | ADMIN
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  notes        Note[]        @relation("NoteAuthor")
  client       Client?
  favorites    Favorite[]
  appointments Appointment[]
  testimonials Testimonial[]
  cartItems    CartItem[]
  orders       Order[]

  @@map("profiles")
}

// Products belong to one of the two branches. `category` is how the
// storefront (and the admin product manager) tells Herbal apart from
// Holistic — see src/app/herbal-holistic/page.tsx.
model Product {
  id          String   @id @default(cuid())
  name        String
  category    String // HERBAL | HOLISTIC
  description String   @default("")
  price       String   @default("") // free-text label shown either way, e.g. "R120" or "Contact for price"
  // The real chargeable price, in cents (ZAR) — null means this product
  // isn't sold online (browse/inquiry only, "Contact for price"). Set this
  // and the storefront shows "Add to Cart" instead of just the label.
  priceCents  Int?
  // Supabase Storage public URL (bucket "product-images") — see
  // supabase/sql/002_storage.sql and ProductManager.tsx's upload flow.
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites  Favorite[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([category])
}

// A signed-in customer saving a product for later — the shop's wishlist.
// Both sides cascade: deleting the product or the account cleans this up
// automatically rather than leaving orphaned rows.
model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user      Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([userId, productId])
}

// A single consultation slot for Journey Home Healing. The founder opens
// it (status OPEN, no customer yet); a signed-in customer books it
// (status BOOKED, customerId set); cancelling — by either side — reopens
// it rather than deleting it, so the slot doesn't need re-creating.
model Appointment {
  id              String   @id @default(cuid())
  startsAt        DateTime
  durationMinutes Int      @default(45)
  status          String   @default("OPEN") // OPEN | BOOKED
  note            String   @default("") // what the customer wants to talk about, optional
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer   Profile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?  @db.Uuid

  @@index([status])
  @@index([startsAt])
}

// A customer's story, submitted from either branch. Held back from public
// view until the founder approves it — see src/app/api/testimonials/.
model Testimonial {
  id         String   @id @default(cuid())
  body       String
  branch     String   @default("JOURNEY_HOME") // JOURNEY_HOME | HERBAL_HOLISTIC
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  author   Profile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String  @db.Uuid

  @@index([isApproved])
}

// A person the owner is tracking — from either branch (Journey Home
// Healing or Makosi Herbal & Holistic Products), or both; nothing here
// ties a Client to one branch specifically. Not every client has
// created a login yet, so the Profile link is optional — set once the
// owner invites them or they sign themselves up.
model Client {
  id        String   @id @default(cuid())
  name      String
  focus     String   @default("") // what they're working through, e.g. "Grief & transition"
  status    String   @default("ACTIVE") // ACTIVE | PAUSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   Profile? @relation(fields: [userId], references: [id])
  userId String?  @unique @db.Uuid

  notes Note[]
}

model Note {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  author   Profile @relation("NoteAuthor", fields: [authorId], references: [id])
  authorId String  @db.Uuid

  @@index([clientId])
  @@index([authorId])
}

// One row per (customer, product) in an active cart — quantity holds how
// many. Checked out into an Order (with a price snapshot) and cleared,
// rather than being an Order itself, so browsing and adding to cart never
// needs a payment provider involved.
model CartItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user      Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([userId, productId])
}

// Flat-rate courier pricing the founder defines (e.g. "Local", "National")
// — the customer picks one at checkout rather than an address being
// looked up against a live courier API. See src/app/api/shipping-zones/.
model ShippingZone {
  id          String   @id @default(cuid())
  name        String
  description String   @default("") // e.g. "Johannesburg & Pretoria, 1-2 days"
  feeCents    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

// A checkout, from cart submission through Yoco payment to fulfillment.
// `status` tracks the payment (set by the Yoco webhook, never trust the
// browser redirect alone for this); `fulfillment` is the founder marking
// it shipped. Item prices and the shipping fee are snapshotted at order
// time — see OrderItem — so later catalog/zone price changes don't alter
// historical orders.
model Order {
  id     String @id @default(cuid())
  status String @default("PENDING") // PENDING | PAID | FAILED
  fulfillment String @default("UNFULFILLED") // UNFULFILLED | SHIPPED

  subtotalCents    Int
  shippingFeeCents Int
  totalCents       Int

  shippingName         String
  shippingPhone        String
  shippingAddressLine1 String
  shippingAddressLine2 String @default("")
  shippingCity         String
  shippingProvince     String
  shippingPostalCode   String

  // Set right after creating the Yoco checkout session; matched back up
  // by the webhook via metadata/clientReferenceId (both set to this
  // Order's id — see src/lib/yoco.ts).
  yocoCheckoutId String? @unique
  yocoPaymentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   Profile @relation(fields: [customerId], references: [id])
  customerId String  @db.Uuid

  zone   ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  zoneId String?

  items OrderItem[]

  @@index([status])
  @@index([customerId])
}

model OrderItem {
  id             String @id @default(cuid())
  productName    String // snapshot — stays correct even if the product is renamed/removed later
  unitPriceCents Int
  quantity       Int

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?

  @@index([orderId])
}
